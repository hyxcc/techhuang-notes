---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatPostDate } from '../../utils/posts';
import { getPublishedProjects } from '../../utils/projects';

const projects = await getPublishedProjects();
---
<BaseLayout title="项目">
  <section class="page-intro shell">
    <p class="eyebrow">Selected work</p>
    <h1>项目</h1>
    <p>记录项目背景、技术选择、实现过程，以及值得保留的工程复盘。</p>
  </section>
  <section class="section shell">
    <div class="project-list">
      {projects.map((project) => (
        <a class="project-row" href={`/projects/${project.id}/`}>
          <div class="project-row-meta">
            <span class="project-status">{project.data.status}</span>
            <span class="meta">{formatPostDate(project.data.date)}</span>
          </div>
          <div>
            <h2>{project.data.title}</h2>
            <p>{project.data.description}</p>
            <div class="tag-list">
              {project.data.tech.map((item) => <span class="tag">{item}</span>)}
            </div>
          </div>
          <span class="arrow">↗</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
